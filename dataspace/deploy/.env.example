# ==============================================================================
# Unified Deployment Configuration (Infraflex + Central-KG + ED-Node + DMS)
# Copy this file to .env and adjust EXTERNAL_HOST for your target machine.
# If EXTERNAL_HOST is left as 'localhost', './deploy.sh prepare' will
# auto-detect the machine's primary IP address for browser-facing services.
# ==============================================================================

# Hostname or IP of the external host machine
EXTERNAL_HOST=localhost
BASE_HOST=localhost

# Directory where git repositories are cloned (relative to deploy/)
REPOS_DIR=./repos

# Git repository URLs and branches
REPO_INFRAFLEX_URL=https://github.com/Flanders-Make-vzw/unimaas-infraflex.git
REPO_INFRAFLEX_BRANCH=main

REPO_CENTRAL_KG_URL=https://github.com/hmarah-fm/central-kg.git
REPO_CENTRAL_KG_BRANCH=main

REPO_ED_NODE_URL=https://github.com/hmarah-fm/ed-node.git
REPO_ED_NODE_BRANCH=master

REPO_DMS_URL=https://github.com/hmarah-fm/ids-mvd-dms.git
REPO_DMS_BRANCH=main

# ==============================================================================
# 1. Infraflex & Eclipse BaSyx Stack Ports
# ==============================================================================
AAS_ENV_PORT=8081
AAS_REGISTRY_PORT=8082
SM_REGISTRY_PORT=8083
AAS_DISCOVERY_PORT=8084
DASHBOARD_API_PORT=8085
AAS_UI_PORT=3000
MOSQUITTO_PORT=1883
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18083
INFRAPLAY_PORT=8090

# Separate GraphDB instance for Infraflex (mapped to 7201 on host to avoid conflict with Central-KG on 7200)
INFRAFLEX_GRAPHDB_PORT=7201
INFRAFLEX_GRAPHDB_REPO=infraflex

# ==============================================================================
# 2. Central-KG & DMS Stack Ports & Credentials
# ==============================================================================
CENTRAL_GRAPHDB_PORT=7200
CENTRAL_GRAPHDB_REPO=centralKG
GRAPHDB_ADMIN_USER=admin
GRAPHDB_ADMIN_PASSWORD=mypassword

CENTRAL_POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgrescp

CENTRAL_KG_API_PORT=8000
CATALOG_MGMT_PORT=8181
CATALOG_PORT=8184
FUSEKI_PROVIDER_PORT=3032

# ==============================================================================
# 3. ED-Node Participants (connector1, connector2, connectorcp) & Trust Stack
# ==============================================================================
NGINX_PROTOCOL=http

# --- Connector 1 (Provider 1) ---
CONNECTOR1_NGINX_PORT=9876
CONNECTOR1_DID=did:web:edc-proxy-connector1%3A80:connector1
CONNECTOR1_OIDC_SECRET=connector1-secret

# --- Connector 2 (Provider 2) ---
CONNECTOR2_NGINX_PORT=9877
CONNECTOR2_DID=did:web:edc-proxy-connector2%3A80:connector2
CONNECTOR2_OIDC_SECRET=connector2-secret

# --- Connector CP (Central Platform Consumer Connector) ---
ED_NODE_INSTANCE_NAME=connectorcp
CONNECTORCP_NGINX_PORT=9878
NGINX_EXPOSED_PORT=9878
ED_NODE_DID_HOST=edc-proxy-connectorcp
ED_NODE_DID_PORT=80
ED_NODE_DID=did:web:edc-proxy-connectorcp%3A80:connectorcp
CONNECTORCP_OIDC_SECRET=connectorcp-secret

IH_HOST=edc-ih-connectorcp
CONNECTOR_HOST=edc-connector-connectorcp
IH_API_KEY=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=
CONNECTOR_IH_API_KEY=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=
CONNECTOR_UNIMAAS_ENABLE_EXTRA_VP_CATALOGREQUEST=true

# IssuerService-VC
ISSUERSERVICEVC_INSTANCE_NAME=issuerservicevc
ISSUERSERVICEVC_EXPOSED_PORT=7000
UNIMAAS_ISSUERSERVICEVC_PROTOCOL=http
UNIMAAS_ISSUERSERVICEVC_HOST=edc-proxy-issuerservicevc
UNIMAAS_ISSUERSERVICEVC_DID_PORT=80
UNIMAAS_ISSUERSERVICEVC_PORT=80
UNIMAAS_ISSUERSERVICEVC_NAME=issuerservicevc
UNIMAAS_ISSUERSERVICEVC_DID=did:web:edc-proxy-issuerservicevc%3A80:issuerservicevc
UNIMAAS_ISSUERSERVICEVC_PATH=/api/v1/issue-credential
GAIAX_ISSUERSERVICEVC_PORT=80
GAIAX_ISSUERSERVICEVC_PATH=/api/v1/issue-gaiax-credential-jwt
EXPIRY_DAYS=365

# Keycloak (OIDC IDP & Participant Directory)
KEYCLOAK_PORT=5080
KEYCLOAK_HTTPS_PORT=5443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
UNIMAAS_OIDC_IDP_PROTOCOL=http
UNIMAAS_OIDC_IDP_HOST=keycloak
UNIMAAS_OIDC_IDP_PORT=8080
UNIMAAS_OIDC_IDP_REALM=unimaas
UNIMAAS_OIDC_IDP_PATH=/realms/unimaas/protocol/openid-connect/token
UNIMAAS_OIDC_IDP_CLIENT_ID=did:web:edc-proxy-connectorcp%3A80:connectorcp
UNIMAAS_OIDC_IDP_CLIENT_SECRET=connectorcp-secret

# Mock Registry
MOCKREGISTRY_EXPOSED_PORT=8089
CONTEXT_URL=http://mock-registry:8080/main/context/2411
VC_CONTEXT_URL=http://mock-registry:8080/main/context/2411
MOCKREGISTRY_CONTEXT_URL=http://mock-registry:8080/main/context/2411

# Credential renewal & XACML policies
UNIMAAS_CREDENTIALS_MEMBERSHIP_DUPLICATE_STRATEGY=REPLACE_ALWAYS
UNIMAAS_CREDENTIALS_DATAPROCESSOR_DUPLICATE_STRATEGY=REPLACE_ALWAYS
UNIMAAS_CREDENTIALS_GAIAX_DUPLICATE_STRATEGY=REPLACE_ALWAYS
UNIMAAS_CREDENTIALS_RENEWAL_ENABLED=true
UNIMAAS_CREDENTIALS_RENEWAL_CHECK_INTERVAL_MINUTES=1440
UNIMAAS_CREDENTIALS_RENEWAL_EXPIRY_THRESHOLD_DAYS=30
XACML_VALIDATION_ENABLED=false
XACML_PDP_ENDPOINT=http://localhost:9092/pdp/verdict
XACML_DOMAIN=unimaas
