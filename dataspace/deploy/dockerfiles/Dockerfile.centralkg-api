# Lightweight Dockerfile for central-platform-kg-api (replaces anaconda/miniconda to avoid repo.anaconda.com blocks)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi[all]" \
    pydantic \
    python-dotenv \
    requests \
    uvicorn

COPY ./main.py /app/main.py
COPY ./api.env /app/api.env

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
