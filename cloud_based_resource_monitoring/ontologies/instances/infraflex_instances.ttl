        "debonder_sensor" ;
    sc:observes inst:characteristic_char_debonder_error_code,
        inst:characteristic_char_debonder_operational_state ;
    sc:samplingRate 1.0 ;
    sc:sensorType "Debonder Telemetry" ;
    rdfs:comment "Infraflex sensor: Debonder Sensor monitoring Infraflex/Executors/Debonder"@en .

sc:Location a owl:Class ;
