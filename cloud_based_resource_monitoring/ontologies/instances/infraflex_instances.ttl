sc:ConfigurableEntity a owl:Class ;
    rdfs:label "Configurable Entity" ;
    rdfs:comment "Base class for entities that have characteristics" .

inst:site_cell5 a sc:Site,
        owl:NamedIndividual ;
    rdfs:label "cell5" ;
    sc:deviceType "Lift",
        "PowerAir" ;
    sc:hasCharacteristic inst:characteristic_char_cell5_available_capacity ;
    sc:hasDevice inst:device_cell5_lift,
        inst:device_cell5_powerair,
        inst:equipmentresource_crx_20ia ;
    sc:id "CELL5",
        "urn:unimaas:infraflex:site:cell5" ;
    sc:location "A",
        "B",
        "C",
        "D",
        "E",
        "F" ;
    sc:locationAddress "UniMaaS Smart Factory, Cell5" ;
    sc:locationAspectDesignation "+Cell5" ;
    sc:mqttPath "Infraflex/Executors/Cell5/Lift",
        "Infraflex/Executors/Cell5/PowerAir" ;
    sc:name "Cell5",
        "cell5" ;
    sc:performs inst:processconfiguration_flashlight_cell5,
        inst:processconfiguration_flashlight_cell5_Step_01_FlashlightPlacePCB,
        inst:processconfiguration_flashlight_cell5_Step_02_FlashlightPlaceCoverClick,
        inst:processconfiguration_flashlight_cell5_Step_03_FlashlightPlaceLensClick,
        inst:processconfiguration_flashlight_cell5_Step_04_FlashlightMoveFlashlightBackClick ;
    rdfs:comment "Infraflex production site Cell5"@en .

inst:site_cell6 a sc:Site,
        owl:NamedIndividual ;
    rdfs:label "cell6" ;
    sc:deviceType "Lift",
        "PowerAir",
        "Turntable" ;
    sc:hasCharacteristic inst:characteristic_char_cell6_available_capacity ;
    sc:hasDevice inst:device_cell6_lift,
        inst:device_cell6_powerair,
        inst:device_cell6_turntable,
        inst:equipmentresource_dossan_h2017 ;
    sc:id "CELL6",
        "urn:unimaas:infraflex:site:cell6" ;
    sc:location "A",
        "B",
        "C",
        "D",
        "E",
        "F" ;
    sc:locationAddress "UniMaaS Smart Factory, Cell6" ;
    sc:locationAspectDesignation "+Cell6" ;
    sc:mqttPath "Infraflex/Executors/Cell6/Lift",
        "Infraflex/Executors/Cell6/PowerAir",
        "Infraflex/Executors/Cell6/Turntable" ;
    sc:name "Cell6",
        "cell6" ;
    sc:performs inst:processconfiguration_flashlight_cell6,
        inst:processconfiguration_flashlight_cell6_Step_01_FlashlightPlacePCB,
        inst:processconfiguration_flashlight_cell6_Step_02_FlashlightPlaceCoverClick,
        inst:processconfiguration_flashlight_cell6_Step_03_FlashlightPlaceLensClick,
        inst:processconfiguration_flashlight_cell6_Step_04_FlashlightMoveFlashlightBackClick ;
    rdfs:comment "Infraflex production site Cell6"@en .

sc:LogisticRoute a owl:Class ;
    rdfs:label "Logistic Route" ;
    rdfs:comment "Transportation route between locations. MSC Logistic Route is aligned with IOF Material Location Change Process when interpreted as transportation activity, and with IOF Plan Specification when interpreted as a route specification." ;
    skos:relatedMatch iof-constr:MaterialLocationChangeProcess,
        iof-constr:PlanSpecification .

sc:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "MSC Resource is aligned with IOF Material Resource at a lightweight mapping level. MSC Resource is broader because it may include material resources, workforce, software, and other assets required to perform processes." ;
    rdfs:subClassOf sc:ConfigurableEntity ;
    skos:closeMatch iof-constr:MaterialResource ;
    skos:relatedMatch iof-constr:MaterialResourceRole .

inst:process_flashlight a sc:Process,
        owl:NamedIndividual ;
    rdfs:label "flashlight" ;
    sc:hasOutput inst:product_flashlight ;
    sc:hasStep inst:process_flashlight_Step_01_FlashlightPlacePCB,
        inst:process_flashlight_Step_02_FlashlightPlaceCoverClick,
        inst:process_flashlight_Step_03_FlashlightPlaceLensClick,
        inst:process_flashlight_Step_04_FlashlightMoveFlashlightBackClick ;
    sc:id "PROC_FLASHLIGHT",
        "urn:unimaas:infraflex:process:flashlight" ;
    sc:isPerformedAt inst:processconfiguration_flashlight_cell5,
        inst:processconfiguration_flashlight_cell6 ;
    sc:name "Flashlight",
        "flashlight" ;
    sc:processType "Assembly" .

sc:Site a owl:Class ;
    rdfs:label "Manufacturing Site" ;
    rdfs:comment "Physical location where processes are performed. MSC Site is aligned with BFO Site, used in IOF as physical location." ;
    rdfs:subClassOf bfo:BFO_0000029,
        sc:ConfigurableEntity ;
    skos:closeMatch bfo:BFO_0000029 .

sc:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "MSC Product is aligned with IOF Material Product. In MSC, a product may be an input to or output of manufacturing service-chain steps." ;
    rdfs:subClassOf sc:ConfigurableEntity ;
    skos:closeMatch iof-constr:MaterialProduct .

sc:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "Equipment or machinery at a site. MSC Device is aligned with IOF Piece of Equipment and related to Engineered System and Material Artifact." ;
    rdfs:subClassOf sc:ConfigurableEntity ;
    skos:closeMatch iof-constr:PieceOfEquipment ;
    skos:relatedMatch iof-constr:EngineeredSystem,
        iof-constr:MaterialArtifact .

sc:EquipmentResource a owl:Class ;
    rdfs:label "Equipment Resource" ;
    rdfs:comment "Equipment or machinery resource used in a manufacturing service chain." ;
    rdfs:subClassOf sc:Resource ;
    skos:closeMatch iof-constr:PieceOfEquipment ;
    skos:relatedMatch iof-constr:EngineeredSystem,
        iof-constr:MaterialArtifact .

sc:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "Measurement device. MSC Sensor is aligned with IOF equipment and measurement capability patterns. A sensor is treated as equipment capable of participating in measurement processes." ;
    skos:closeMatch iof-constr:PieceOfEquipment ;
    skos:relatedMatch iof-constr:MeasurementCapability,
        iof-constr:MeasurementProcess .

sc:ProcessConfiguration a owl:Class ;
    rdfs:label "Process Configuration" ;
    rdfs:comment "MSC Process Configuration is aligned with IOF Plan Specification because it specifies a configured manufacturing service-chain step, binding the specific input and output parameters" ;
    rdfs:subClassOf iof-constr:PlanSpecification ;
    skos:closeMatch iof-constr:PlanSpecification .

sc:Characteristic a owl:Class ;
    rdfs:label "Characteristic" ;
    rdfs:comment "MSC Characteristic is a lightweight abstraction for attributes of products, resources, devices, sites, or suppliers. It may correspond to an IOF Capability, IOF Process Characteristic, BFO Quality, or other specifically dependent continuant depending on context." ;
    skos:relatedMatch bfo:BFO_0000019,
        bfo:BFO_0000020,
        iof-constr:Capability,
        iof-constr:ProcessCharacteristic .

